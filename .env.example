# Optional shopper features. The default app needs none of these.
# Public Firebase web configuration (not an admin credential):
SHOPPER_FIREBASE_API_KEY=
SHOPPER_FIREBASE_PROJECT_ID=
SHOPPER_CLOUD_SYNC=false
# Matching server verification config:
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Required for online AI to enforce durable per-user AND per-IP quotas:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
# Optional intent classification only; deterministic catalog responses still apply.
GEMINI_API_KEY=
GEMINI_MODEL=
# Fine-grained GitHub token, contents write on this repository ONLY. Server-side.
CATALOG_GITHUB_TOKEN=
CATALOG_GITHUB_REPOSITORY=danne6077-beep/CYCLE-COUNT1
CATALOG_GITHUB_BRANCH=main
